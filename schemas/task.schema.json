{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/OssaBellator/autoprompter/schemas/task.schema.json",
  "title": "AutoPrompter Task",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "projectId",
    "id",
    "title",
    "description",
    "status",
    "role",
    "difficulty",
    "preferredModelClass",
    "dependencies",
    "allowedPaths",
    "acceptanceCriteria",
    "verificationCommands",
    "attempt",
    "lease",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "projectId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"
    },
    "id": {
      "type": "string",
      "pattern": "^task-[a-z0-9._-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12000
    },
    "status": {
      "type": "string",
      "enum": [
        "blocked",
        "ready",
        "leased",
        "running",
        "review",
        "revision_required",
        "accepted",
        "failed",
        "cancelled"
      ]
    },
    "role": {
      "type": "string",
      "enum": [
        "implementation",
        "research",
        "testing",
        "documentation",
        "review",
        "integration"
      ]
    },
    "difficulty": {
      "type": "string",
      "enum": [
        "small",
        "medium",
        "large",
        "critical"
      ]
    },
    "preferredModelClass": {
      "type": "string",
      "enum": [
        "fast",
        "standard",
        "deep"
      ]
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^task-[a-z0-9._-]+$"
      },
      "uniqueItems": true
    },
    "allowedPaths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^(?!/)(?!.*\\.\\.)[^\\u0000]+$",
        "maxLength": 300
      },
      "uniqueItems": true
    },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    },
    "verificationCommands": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    },
    "branch": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 240
    },
    "attempt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 50
    },
    "lease": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "dispatchId",
            "workerChatId",
            "assignedAt",
            "expiresAt",
            "attempt"
          ],
          "properties": {
            "dispatchId": {
              "type": "string",
              "pattern": "^dispatch-[a-z0-9._-]+$",
              "maxLength": 200
            },
            "workerChatId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "assignedAt": {
              "type": "string",
              "format": "date-time"
            },
            "expiresAt": {
              "type": "string",
              "format": "date-time"
            },
            "attempt": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          }
        }
      ]
    },
    "resultCommit": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-fA-F]{7,64}$"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
