{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/OssaBellator/autoprompter/schemas/plan.schema.json",
  "title": "AutoPrompter Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "projectId",
    "revision",
    "requiresMultipleAgents",
    "rationale",
    "phases",
    "tasks",
    "criticalPath",
    "createdAt"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "projectId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$" },
    "revision": { "type": "integer", "minimum": 1 },
    "requiresMultipleAgents": { "type": "boolean" },
    "rationale": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "taskIds", "acceptanceCriteria"],
        "properties": {
          "id": { "type": "string", "pattern": "^phase-[a-z0-9._-]+$" },
          "title": { "type": "string", "minLength": 1, "maxLength": 160 },
          "taskIds": {
            "type": "array",
            "items": { "type": "string", "pattern": "^task-[a-z0-9._-]+$" },
            "uniqueItems": true
          },
          "acceptanceCriteria": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
          }
        }
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "dependencies", "role", "difficulty", "preferredModelClass"],
        "properties": {
          "id": { "type": "string", "pattern": "^task-[a-z0-9._-]+$" },
          "title": { "type": "string", "minLength": 1, "maxLength": 200 },
          "dependencies": {
            "type": "array",
            "items": { "type": "string", "pattern": "^task-[a-z0-9._-]+$" },
            "uniqueItems": true
          },
          "role": {
            "type": "string",
            "enum": ["planner", "implementation", "research", "testing", "documentation", "review", "integration"]
          },
          "difficulty": { "type": "string", "enum": ["small", "medium", "large", "critical"] },
          "preferredModelClass": { "type": "string", "enum": ["fast", "standard", "deep"] }
        }
      }
    },
    "criticalPath": {
      "type": "array",
      "items": { "type": "string", "pattern": "^task-[a-z0-9._-]+$" },
      "uniqueItems": true
    },
    "createdAt": { "type": "string", "format": "date-time" }
  }
}
