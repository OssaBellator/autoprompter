{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/OssaBellator/autoprompter/schemas/integration.schema.json",
  "title": "AutoPrompter Integration Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "projectId", "planRevision", "status", "summary", "branch", "commit", "includedTasks", "tests", "conflicts", "risks", "producedAt"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "projectId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$" },
    "planRevision": { "type": "integer", "minimum": 1 },
    "status": { "enum": ["completed", "blocked", "failed"] },
    "summary": { "type": "string", "minLength": 1, "maxLength": 12000 },
    "branch": { "type": "string", "pattern": "^agent/[a-z0-9._/-]+$", "maxLength": 240 },
    "commit": { "type": ["string", "null"], "pattern": "^[0-9a-fA-F]{7,64}$" },
    "includedTasks": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^task-[a-z0-9._-]+$" } },
    "tests": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "status", "summary"],
        "properties": {
          "command": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "status": { "enum": ["passed", "failed", "not_run"] },
          "summary": { "type": "string", "maxLength": 4000 }
        }
      }
    },
    "conflicts": { "type": "array", "maxItems": 50, "items": { "type": "string", "minLength": 1, "maxLength": 2000 } },
    "risks": { "type": "array", "maxItems": 50, "items": { "type": "string", "minLength": 1, "maxLength": 2000 } },
    "producedAt": { "type": "string", "format": "date-time" }
  }
}
