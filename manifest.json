{
  "manifest_version": 3,
  "name": "AutoPrompter for ChatGPT",
  "version": "2.6.0",
  "description": "Run recent ChatGPT conversations concurrently with optional fresh-chat starts, progress tracking, continuity initialization, notifications, and guarded repository handoffs.",
  "minimum_chrome_version": "102",
  "permissions": [
    "storage",
    "tabs",
    "notifications"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "action": {
    "default_title": "AutoPrompter",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
