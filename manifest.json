{
  "manifest_version": 3,
  "name": "AutoPrompter for ChatGPT",
  "version": "3.1.0",
  "description": "Create and coordinate ChatGPT Web multi-agent projects with deterministic plan compilation, concurrent workers, independent reviews, and guarded integration.",
  "minimum_chrome_version": "102",
  "permissions": [
    "storage",
    "tabs",
    "notifications"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "action": {
    "default_title": "AutoPrompter",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background-entry.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
